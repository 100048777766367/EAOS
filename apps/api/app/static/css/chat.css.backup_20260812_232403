/* === EAOS_RESIZER_V3_BEGIN === */

.eaos-pane-resizer {
    position: relative;
    z-index: 9999;
    flex: 0 0 auto;
    background: transparent;
    user-select: none;
    touch-action: none;
}

.eaos-horizontal-resizer {
    width: 6px;
    min-width: 6px;
    height: 100%;
    cursor: col-resize;
}

.eaos-vertical-resizer {
    width: 100%;
    min-width: 100%;
    height: 6px;
    min-height: 6px;
    cursor: row-resize;
}

.eaos-horizontal-resizer::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 2px;
    width: 2px;
    background: #1e293b;
    content: "";
}

.eaos-horizontal-resizer:hover::before,
.eaos-horizontal-resizer.active::before {
    background: #22d3ee;
}

.eaos-vertical-resizer::before {
    position: absolute;
    top: 2px;
    right: 0;
    left: 0;
    height: 2px;
    background: #1e293b;
    content: "";
}

.eaos-vertical-resizer:hover::before,
.eaos-vertical-resizer.active::before {
    background: #22d3ee;
}

.eaos-workspace-shell.resizing,
.eaos-workspace-shell.resizing * {
    cursor: inherit !important;
}

.eaos-resize-overlay {
    position: fixed;
    z-index: 100000;
    inset: 0;
    background: transparent;
    user-select: none;
    touch-action: none;
}

body.eaos-resizing {
    user-select: none !important;
    overflow: hidden !important;
}

