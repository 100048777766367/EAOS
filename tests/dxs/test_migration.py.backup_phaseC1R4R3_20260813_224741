def test_major_migration_is_blocked() -> None:
    service = MigrationService(CompatibilityService(CompatibilityChecker()))

    result = service.plan(
        MigrationRequest(
            current_version="1.0.0",
            target_version="2.0.0",
        )
    )

    assert result.compatible is False
    assert result.status == "BLOCKED"
