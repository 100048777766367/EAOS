COMMAND_ALIASES: dict[str, str] = {
    "diag": "diagnose",
    "evo": "evolution",
    "remediate": "remediation",
    "selfcheck": "self-diagnostics",
}


def _print_header(title: str) -> None:
    print()
    print("=" * 72)
    print(title)
    print("=" * 72)


def _print_footer() -> None:
    print("=" * 72)


def _doctor(root: Path) -> int:
    application = create_repository_application()
    results = application.inspect(root)

    _print_header("EAOS — DXS REPOSITORY DOCTOR")

    failed = False

    for result in results:
        print(result)
        failed |= result.startswith(("[WARN]", "[FAIL]"))

    _print_footer()
    return int(failed)


def _discover(root: Path) -> int:
    service = create_repository_application()

    try:
        result = service.discover(root)
    except AttributeError:
        result = discover_repository()

    _print_header("EAOS — DXS REPOSITORY DISCOVERY")
    print(result)
    _print_footer()

    return 0


def _validate(root: Path) -> int:
    application = create_repository_application()
    results = application.validate(root)

    _print_header("EAOS — DXS REPOSITORY VALIDATION")

    failed = False

    for result in results:
        status = result.status.value
        print(f"[{status}] {result.check}: {result.message}")
        failed |= status == "fail"

    _print_footer()
    return int(failed)


def _diagnose(root: Path) -> int:
    service = DebuggingService()
    results = service.inspect(root)

    _print_header("EAOS — DXS DIAGNOSTICS")

    failed = False

    for result in results:
        print(result)
        failed |= not result.passed

    _print_footer()
    return int(failed)


def _health(root: Path) -> int:
    application = create_repository_application()

    _print_header("EAOS — DXS HEALTH")

    try:
        results = application.health(root)
    except AttributeError:
        print("[INFO] Health service is not exposed by the repository application.")
        print("[PASS] DXS health command is available.")
        _print_footer()
        return 0

    if isinstance(results, (str, bytes)):
        print(results)
        _print_footer()
        return 0

    failed = False

    for result in results:
        print(result)

        if hasattr(result, "passed"):
            failed |= not result.passed

    _print_footer()
    return int(failed)


