.eaos-workspace-shell.eaos-focus-mode
#resizer-copilot,

.eaos-workspace-shell.eaos-focus-mode
#pane-right-inspector,

.eaos-workspace-shell.eaos-focus-mode
#resizer-terminal,

.eaos-workspace-shell.eaos-focus-mode
#pane-bottom-terminal {
    display: none !important;
}

.eaos-workspace-shell.eaos-focus-mode
.eaos-center-workspace {
    width: 100%;
    flex: 1 1 100%;
}

body.eaos-focus-mode .eaos-ide-header {
