# ============================================================
# EAOS ENTERPRISE REPOSITORY .GITIGNORE
# Purpose:
# - Ignore local/runtime/generated/recovery material
# - Preserve source, architecture, tests, docs, and contracts
# - Apply consistently across all branches
# ============================================================


# ============================================================
# 1. PYTHON
# ============================================================

__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
ENV/
env/

.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.pyright/
.cache/

.tox/
.nox/
.hypothesis/

.coverage
.coverage.*
htmlcov/

*.egg-info/
.installed.cfg
*.egg
build/
dist/

.uv/
uv-cache/
pip-wheel-metadata/


# ============================================================
# 2. ENVIRONMENT / SECRETS
# ============================================================

.env
.env.*
!.env.example
!.env.*.example

secrets/
credentials/
*.secret

*.pem
*.key
*.crt
*.cer
*.pfx
*.p12

id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ovpn


# ============================================================
# 3. NODE / JAVASCRIPT / FRONTEND
# ============================================================

node_modules/
**/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

.npm/
.pnpm-store/
.yarn/
.yarn-cache/

.next/
.nuxt/
.svelte-kit/
.turbo/
.vite/
.parcel-cache/
.cache/

**/dist/
**/build/

# Preserve explicitly versioned source directories when needed.
!apps/**/src/
!frontend/src/


# ============================================================
# 4. IDE / EDITOR
# ============================================================

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml

*.swp
*.swo
*~
.history/


# ============================================================
# 5. OPERATING SYSTEM
# ============================================================

.DS_Store
.DS_Store?
._*

.Spotlight-V100
.Trashes

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini


# ============================================================
# 6. DATABASE / LOCAL STORAGE
# ============================================================

*.db
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

data/
local-data/
storage/
tmp/
temp/

dump.rdb

minio-data/
postgres-data/
neo4j-data/
qdrant-data/

qdrant_storage/
chroma_db/
milvus_data/
weaviate_data/


# ============================================================
# 7. DOCKER / LOCAL INFRASTRUCTURE
# ============================================================

.docker/
docker-data/
docker-volumes/

# Local compose overrides.
docker-compose.override.yml
compose.override.yml


# ============================================================
# 8. CLOUD / INFRASTRUCTURE LOCAL STATE
# ============================================================

.terraform/
.terraform.lock.hcl.local

*.tfstate
*.tfstate.*
crash.log

override.tf
override.tf.json
*_override.tf
*_override.tf.json

.kube/
kubeconfig
kubeconfig.*
.aws/
.azure/
.gcp/
.serverless/


# ============================================================
# 9. COMPILED / GENERATED BUILD OUTPUT
# ============================================================

*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib

*.class
*.jar
*.war
*.ear

.gradle/
target/

obj/
*.suo
*.user
*.userosscache
*.sln.docstates


# ============================================================
# 10. MACHINE LEARNING / MODEL CACHE
# ============================================================

models/cache/
ollama_models/

*.ckpt
*.safetensors
*.onnx
*.h5
*.weights

# Large model binaries are local artifacts unless explicitly tracked.
*.pt
*.pth


# ============================================================
# 11. EAOS RUNTIME / LOGS / TRACES
# ============================================================

/runtime/logs/
/runtime/tmp/
/runtime/traces/
/runtime/backups/

# Generated architecture/compiler output.
/generated/architecture/time_machine/
/generated/compiler/


# ============================================================
# 12. EAOS LOCAL STATE
# ============================================================
#
# These are machine-local mutable state.
# They must never be committed to Git.
#

/.eaos/
/.eaos-backups/
/.eaos_ledger/


# Future EAOS root-level local state/recovery artifacts.
#
# Covers:
#   .eaos_p03_...
#   .eaos_p07_...
#   .eaos_restore_...
#   .eaos_runtime_...
#   .eaos_*_backup_...
#   .eaos_runtime_forensics/
#
/.eaos_*/


# ============================================================
# 13. EAOS RECOVERY / SNAPSHOT MATERIAL
# ============================================================
#
# Covers future recovery material below .eaos/ if a component
# creates it using a nested structure.
#

/.eaos/backups/
/.eaos/checkpoints/
/.eaos/repairs/
/.eaos/runtime/
/.eaos/snapshots/
/.eaos/recovery/


# ============================================================
# 14. EAOS GENERATED LOCAL ARTIFACTS
# ============================================================
#
# Only explicitly designated generated/local locations are
# ignored. Source directories such as apps/, agents/, packages/
# remain trackable.
#

/artifacts/local/
/artifacts/generated/
/artifacts/runtime/

/generated/local/
/generated/runtime/
/generated/tmp/


# ============================================================
# 15. LOGS / REPORTS GENERATED LOCALLY
# ============================================================

*.log
*.trace
*.tmp
*.temp

/logs/
/reports/local/
/reports/generated/


# ============================================================
# 16. BACKUP FILES
# ============================================================
#
# General backup suffixes are ignored to prevent accidental
# commits of local recovery copies.
#

*.bak
*.backup
*.old
*.orig
*.rej

# Timestamped EAOS recovery copies.
*.backup_*
*.bak_*
*.restore_*


# ============================================================
# 17. ARCHIVE / EXPORT ARTIFACTS
# ============================================================
#
# Do NOT ignore normal source archives globally.
# Only local/export locations are ignored.
#

/exports/local/
/exports/generated/
/packages/local/


# ============================================================
# 18. COVERAGE / TEST ARTIFACTS
# ============================================================

coverage.xml
coverage.json
.pytest_cache/
test-results/
test-results-local/
junit.xml


# ============================================================
# 19. OS / TOOL TEMPORARY FILES
# ============================================================

*.pid
*.lock
*.pid.lock

.DS_Store
Thumbs.db


# ============================================================
# 20. EAOS FUTURE LOCAL-ONLY NAMING CONVENTIONS
# ============================================================
#
# Reserved local-only root namespaces.
#
# IMPORTANT:
# Do not create production source under these prefixes.
#

/.local-*
/.local_*

/.eaos-local-*
/.eaos-local_*
