def _add_version_arguments(
    parser: argparse.ArgumentParser,
) -> None:
    parser.add_argument(
        "--current",
        default="1.0.0",
        help="Current contract version.",
    )

    parser.add_argument(
        "--target",
        default="1.0.0",
        help="Target contract version.",
    )


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="eaos",
        description="EAOS Developer Experience System",
    )

    parser.add_argument(
        "--root",
        type=Path,
        default=None,
        help="EAOS repository root.",
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    # --------------------------------------------------------
    # Repository lifecycle
    # --------------------------------------------------------

    subparsers.add_parser(
        "doctor",
        help="Inspect EAOS repository sources.",
    )

    subparsers.add_parser(
        "discover",
        help="Discover the EAOS repository and workspace.",
    )

    subparsers.add_parser(
        "validate",
        help="Validate EAOS repository sources.",
    )

    subparsers.add_parser(
        "diagnose",
        aliases=["diag"],
        help="Run deterministic DXS diagnostics.",
    )

    subparsers.add_parser(
        "health",
        help="Inspect DXS health.",
    )

    subparsers.add_parser(
        "evidence",
        help="Inspect DXS evidence.",
    )

    # --------------------------------------------------------
    # Contract lifecycle
    # --------------------------------------------------------

    compatibility = subparsers.add_parser(
        "compatibility",
        help="Check contract version compatibility.",
    )

    _add_version_arguments(compatibility)

    migration = subparsers.add_parser(
        "migration",
        help="Plan a contract migration.",
    )

    _add_version_arguments(migration)

    subparsers.add_parser(
        "evolution",
        aliases=["evo"],
        help="Inspect evolutionary readiness.",
    )

    subparsers.add_parser(
        "remediation",
        aliases=["remediate"],
        help="Inspect or execute remediation workflows.",
    )

    subparsers.add_parser(
        "scaffold",
        help="Inspect or execute DXS scaffolding.",
    )

    # --------------------------------------------------------
    # Developer experience
    # --------------------------------------------------------

    subparsers.add_parser(
        "workspace",
        help="Inspect EAOS workspace structure.",
    )

    subparsers.add_parser(
        "documentation",
        help="Inspect authoritative EAOS documentation.",
    )

    subparsers.add_parser(
        "ide",
        help="Inspect IDE configuration.",
    )

    subparsers.add_parser(
        "integrations",
        help="Inspect integration configuration.",
    )

    # --------------------------------------------------------
    # AI
    # --------------------------------------------------------

    ai_parser = subparsers.add_parser(
        "ai",
        help="EAOS AI services.",
    )

    ai_subparsers = ai_parser.add_subparsers(
        dest="ai_command",
        required=True,
    )

    ai_subparsers.add_parser(
        "capability",
        help="Inspect AI capabilities.",
    )

    ai_subparsers.add_parser(
        "policy",
        help="Inspect AI policies.",
    )

    ai_subparsers.add_parser(
        "adapter",
        help="Inspect AI adapters.",
    )

    # --------------------------------------------------------
    # Platform governance
    # --------------------------------------------------------

    subparsers.add_parser(
        "policies",
        help="Inspect DXS policies.",
    )

    subparsers.add_parser(
        "governance",
        help="Inspect DXS governance.",
    )

    subparsers.add_parser(
        "orchestration",
        help="Inspect DXS orchestration.",
    )

    subparsers.add_parser(
        "observability",
        help="Inspect DXS observability.",
    )

    # --------------------------------------------------------
    # Self diagnostics
    # --------------------------------------------------------

    subparsers.add_parser(
        "self-diagnostics",
        aliases=["selfcheck"],
        help="Run DXS self-diagnostics and architecture checks.",
    )

    return parser


def _dispatch(
    args: argparse.Namespace,
    root: Path,
) -> int:
    command = COMMAND_ALIASES.get(args.command, args.command)

    if command == "doctor":
        return _doctor(root)

    if command == "discover":
        return _discover(root)

    if command == "validate":
        return _validate(root)

    if command == "diagnose":
        return _diagnose(root)

    if command == "health":
        return _health(root)

    if command == "evidence":
        return _evidence(root)

    if command == "compatibility":
        return _compatibility(
            args.current,
            args.target,
        )

    if command == "migration":
        return _migration(
            args.current,
            args.target,
        )

    if command == "evolution":
        return _evolution(root)

    if command == "remediation":
        return _remediation(root)

    if command == "scaffold":
        return _scaffold(root)

    if command == "workspace":
        return _workspace(root)

    if command == "documentation":
        return _documentation(root)

    if command == "ide":
        return _ide(root)

    if command == "integrations":
        return _integrations(root)

    if command == "policies":
        return _policies(root)

    if command == "governance":
        return _governance(root)

    if command == "orchestration":
        return _orchestration(root)

    if command == "observability":
        return _observability(root)

    if command == "self-diagnostics":
        return _self_diagnostics(root)

    if command == "ai":
        if args.ai_command == "capability":
            return _ai_capability(root)

        if args.ai_command == "policy":
            return _ai_policy(root)

        if args.ai_command == "adapter":
            return _ai_adapter(root)

        raise ValueError(f"Unknown AI command: {args.ai_command}")

    raise ValueError(f"Unknown command: {args.command}")


def main() -> int:
    parser = _build_parser()
    args = parser.parse_args()

    root = args.root.resolve() if args.root is not None else discover_repository()

    return _dispatch(args, root)


if __name__ == "__main__":
    raise SystemExit(main())
