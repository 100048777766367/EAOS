/* ---------- RESIZERS ---------- */

.eaos-pane-resizer {
    position: relative;
    z-index: 50;
    flex-shrink: 0;
    background: transparent;
    transition: background 120ms ease;
}

.eaos-pane-resizer:hover,
.eaos-pane-resizer.active {
    background: #155e75;
}

.eaos-horizontal-resizer {
    width: 3px;
    cursor: col-resize;
}

.eaos-vertical-resizer {
    height: 3px;
    cursor: row-resize;
}

.eaos-horizontal-resizer::after {
    position: absolute;
    inset: 0 -3px;
    content: "";
}

.eaos-vertical-resizer::after {
    position: absolute;
    inset: -3px 0;
    content: "";
}

