/* ============================================================
   EAOS IDE — Pane Resizer Runtime Stabilization
   Responsibility:
   - reliable pointer hit area
   - flex isolation
   - drag cursor
   - prevent transition interference while resizing
   ============================================================ */

.eaos-pane-resizer {
    position: relative;
    z-index: 50;

    flex: 0 0 6px;

    display: block;

    padding: 0;
    margin: 0;

    background: transparent;

    opacity: 1;

    pointer-events: auto;

    user-select: none;
    -webkit-user-select: none;

    touch-action: none;

    transition:
        background-color 120ms ease,
        opacity 120ms ease;
}

.eaos-pane-resizer:hover,
.eaos-pane-resizer:focus-visible,
.eaos-pane-resizer.is-resizing {
    background: rgba(34, 211, 238, 0.28);

    outline: none;
}

.eaos-horizontal-resizer {
    width: 6px;
    min-width: 6px;
    max-width: 6px;

    height: 100%;

    cursor: col-resize;

    align-self: stretch;
}

.eaos-vertical-resizer {
    width: 100%;
    min-width: 0;
    max-width: none;

    height: 6px;
    min-height: 6px;
    max-height: 6px;

    cursor: row-resize;

    align-self: stretch;

    flex: 0 0 6px;
}


/* ------------------------------------------------------------
   Prevent flexbox from collapsing resizer / pane boundaries.
   ------------------------------------------------------------ */

.eaos-workspace-shell {
    min-width: 0;
    min-height: 0;
}

.eaos-center-workspace {
    min-width: 0;
    min-height: 0;
}

#pane-left-explorer,
#pane-right-inspector,
#pane-bottom-terminal {
    flex-shrink: 0;
}


/* ------------------------------------------------------------
   During drag, transitions must not fight pointer movement.
   ------------------------------------------------------------ */

body.eaos-resizing .eaos-pane-resizer,
body.eaos-resizing #pane-left-explorer,
body.eaos-resizing #pane-right-inspector,
body.eaos-resizing #pane-bottom-terminal {
    transition: none !important;
}

body.eaos-resizing,
body.eaos-resizing * {
    cursor: inherit;
}

body.eaos-resizing-explorer,
body.eaos-resizing-right {
    cursor: col-resize !important;
}

body.eaos-resizing-explorer *,
body.eaos-resizing-right * {
    cursor: col-resize !important;
}

body.eaos-resizing-terminal {
    cursor: row-resize !important;
}

body.eaos-resizing-terminal * {
    cursor: row-resize !important;
}


/* ------------------------------------------------------------
   Keep center editor capable of shrinking while side panes
   retain their explicit dimensions.
   ------------------------------------------------------------ */

.eaos-center-workspace,
.eaos-editor-pane {
    min-width: 0 !important;
    min-height: 0 !important;
}


/* ------------------------------------------------------------
   Terminal must participate in vertical flex layout correctly.
   JS controls the explicit height.
   ------------------------------------------------------------ */

#pane-bottom-terminal {
    box-sizing: border-box;

    flex-shrink: 0;

    overflow: hidden;
}

#resizer-terminal {
    flex-shrink: 0;
}


/* ------------------------------------------------------------
   Stronger hit target without visually increasing the divider.
   ------------------------------------------------------------ */

#resizer-explorer,
#resizer-copilot,
#resizer-terminal {
    isolation: isolate;
}

#resizer-explorer::before,
#resizer-copilot::before,
#resizer-terminal::before {
    content: "";

    position: absolute;

    z-index: 51;

    pointer-events: auto;
}

#resizer-explorer::before,
#resizer-copilot::before {
    top: 0;
    bottom: 0;

    left: -4px;
    right: -4px;
}

#resizer-terminal::before {
    left: 0;
    right: 0;

    top: -4px;
    bottom: -4px;
}


/* ------------------------------------------------------------
   When a pane is hidden, its resizer must disappear with it.
   ------------------------------------------------------------ */

.eaos-pane-hidden + .eaos-pane-resizer,
.eaos-pane-resizer.eaos-pane-hidden {
    display: none !important;
}

