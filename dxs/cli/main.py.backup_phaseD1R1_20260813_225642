def _policies(root: Path) -> int:
    _print_header("EAOS — DXS POLICIES")

    policy_dir = root / "dxs" / "policies"

    if not policy_dir.exists():
        print(f"[INFO] Policy directory does not exist: {policy_dir}")
        print("[INFO] Create policies here as the DXS policy layer evolves.")
        _print_footer()
        return 0

    files = sorted(policy_dir.rglob("*"))

    if not files:
        print("[INFO] Policy directory is empty.")
    else:
        for path in files:
            if path.is_file():
                print(f"[FILE] {path.relative_to(root)}")

    _print_footer()
    return 0


