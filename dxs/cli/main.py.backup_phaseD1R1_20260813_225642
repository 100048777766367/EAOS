def _compatibility(
    current_value: str,
    target_value: str,
) -> int:
    current = ContractVersion.parse(current_value)
    target = ContractVersion.parse(target_value)

    service = CompatibilityService()

    result = service.check(
        current=current,
        target=target,
    )

    _print_header("EAOS — DXS CONTRACT COMPATIBILITY")

    print(f"Current : {result.current_version}")
    print(f"Target  : {result.target_version}")
    print(f"Policy  : minor={result.policy.allow_minor_upgrade}, patch={result.policy.allow_patch_upgrade}")
    print(f"Status  : {result.status.upper()}")
    print(f"Reason  : {result.reason}")

    _print_footer()

    return 0 if result.compatible else 1


def _migration(
    current_value: str,
    target_value: str,
) -> int:
    service = MigrationService()

    result = service.plan(
