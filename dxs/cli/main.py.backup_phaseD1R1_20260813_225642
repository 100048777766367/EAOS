    _print_footer()

    return 0 if result.compatible else 1


def _evolution(root: Path) -> int:
    service = EvolutionService()

    _print_header("EAOS — DXS EVOLUTION")

    try:
        result = service.inspect(root)
    except AttributeError:
        try:
            result = service.evaluate(root)
        except AttributeError:
            print("[INFO] Evolution service is available but exposes no CLI inspection method.")
            _print_footer()
            return 0

    if isinstance(result, (str, bytes)):
        print(result)
    else:
        print(result)

    _print_footer()
    return 0


